# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Prisma CLI and seed: use Supabase session pooler (5432) or direct connection.
# Application queries continue to use DATABASE_URL (transaction pooler in Supabase).
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# The storefront always reads PostgreSQL; there is no static commerce fallback.

# Bank transfer remains unavailable until enabled with all real required values.
BANK_TRANSFER_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_HOLDER=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
# Optional holder identification, only if needed for transfers.
BANK_ID_NUMBER=

# Bootstrap only: prefer temporary shell environment values, not persisted .env secrets.
# Run npm run admin:create deliberately after applying migrations.
ADMIN_BOOTSTRAP_CONFIRM=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
# Explicitly allow a separate additional account only when needed.
ADMIN_BOOTSTRAP_ALLOW_ADDITIONAL=false
